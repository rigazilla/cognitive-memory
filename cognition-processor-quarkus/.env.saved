# Memory Service - Local Development Environment Variables
# Copy this file to .env and adjust values as needed

# When using Ollama, point to host machine via host.docker.internal
# OPENAI_BASE_URL=http://host.docker.internal:11434
OPENAI_BASE_URL=https://gpt-oss-20b--apicast-production.apps.int.stc.ai.prod.us-east-1.aws.paas.redhat.com:443
# OPENAI_API_KEY=ollama
OPENAI_API_KEY=dfdfacdfe35d9ce3f5a3dcfec2fba8d7
# Choose a lightweight model for faster responses (qwen2.5:1.5b, llama3.2, etc.)
# OPENAI_MODEL=qwen2.5:1.5b
OPENAI_MODEL=openai/gpt-oss-20b

# Embedding configuration (used by memory-service for semantic search)
# Uses Ollama's OpenAI-compatible endpoint (/v1)
# MEMORY_SERVICE_EMBEDDING_OPENAI_API_KEY=ollama
MEMORY_SERVICE_EMBEDDING_OPENAI_API_KEY=00c17a470a18d66c19dc9ac21eadf3c8
# MEMORY_SERVICE_EMBEDDING_OPENAI_BASE_URL=http://host.docker.internal:11434/v1
MEMORY_SERVICE_EMBEDDING_OPENAI_BASE_URL=https://nomic-embed-text-v1-5--apicast-production.apps.int.stc.ai.prod.us-east-1.aws.paas.redhat.com/v1
# Recommended embedding model (pull with: ollama pull nomic-embed-text)
# MEMORY_SERVICE_EMBEDDING_OPENAI_MODEL_NAME=nomic-embed-text
MEMORY_SERVICE_EMBEDDING_OPENAI_MODEL_NAME=nomic-ai/nomic-embed-text-v1.5
MEMORY_SERVICE_EMBEDDING_OPENAI_DIMENSIONS=768


# Cognition Processor Configuration (Red Hat Internal Endpoints)
# Memory model configuration (for extraction and verification)
COGNITION_OPENAI_BASE_URL=https://gpt-oss-20b--apicast-production.apps.int.stc.ai.prod.us-east-1.aws.paas.redhat.com:443/v1
COGNITION_OPENAI_MODEL_NAME=openai/gpt-oss-20b
COGNITION_OPENAI_API_KEY=dfdfacdfe35d9ce3f5a3dcfec2fba8d7

JAVA_UNSAFE_SSL=-Dquarkus.tls.trust-all=true

MEMORY_SERVICE_API_KEY=cognition-processor-key-123

# Worker/runtime identity
MEMORY_SERVICE_CLIENT_ID=cognition_processor
COGNITION_WORKER_ID=cognition_processor
COGNITION_RUNTIME_ID=cognition-processor-v1
COGNITION_RUNTIME_VERSION=1.0.0-SNAPSHOT
COGNITION_CHECKPOINT_RESET_ON_STARTUP=false
